diff --git i/src/el_table.cpp w/src/el_table.cpp
index c3ce2a9f..a7d66ed7 100644
--- i/src/el_table.cpp
+++ w/src/el_table.cpp
@@ -1,4 +1,5 @@
 #include "el_table.h"
+#include "html.h"
 #include "document.h"
 
 namespace litehtml
@@ -41,6 +42,33 @@ namespace litehtml
 		str = get_attr("bgcolor");
 		if(str) { m_style.add_property(_background_color_, str, "", false, get_document()->container()); }
 
+		// https://html.spec.whatwg.org/multipage/rendering.html#tables-2:attr-table-align
+		// align=center centers the table via auto margins; left/right float it.
+		str = get_attr("align");
+		if(str)
+		{
+			if(!t_strcasecmp(str, "center") || !t_strcasecmp(str, "middle"))
+			{
+				m_style.add_property(_margin_left_, "auto", "", false, get_document()->container());
+				m_style.add_property(_margin_right_, "auto", "", false, get_document()->container());
+			}
+			else if(!t_strcasecmp(str, "left") || !t_strcasecmp(str, "right"))
+			{
+				m_style.add_property(_float_, str, "", false, get_document()->container());
+			}
+		}
+		else if(auto p = parent())
+		{
+			// Browsers center block children of <center> and align=center
+			// containers (-webkit-center); e-mail buttons/images depend on it.
+			const char* pa = p->get_attr("align");
+			if((pa && (!t_strcasecmp(pa, "center") || !t_strcasecmp(pa, "middle"))) ||
+			   !t_strcasecmp(p->get_tagName(), "center"))
+			{
+				m_style.add_property(_margin_left_, "auto", "", false, get_document()->container());
+				m_style.add_property(_margin_right_, "auto", "", false, get_document()->container());
+			}
+		}
 		html_tag::parse_attributes();
 	}
 
