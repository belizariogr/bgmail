#!/usr/bin/env bash
# Regenerates every derived app icon from assets/appIcon/BGMail.svg:
# BGMail-{16..1024}.png, BGMail.ico (PNG frames 16-256) and BGMail.icns
# (icp4/icp5/icp6/ic07-ic14). Needs rsvg-convert and python3; adds nothing to
# the workspace build.
set -euo pipefail

dir="$(cd "$(dirname "$0")/.." && pwd)/assets/appIcon"
command -v rsvg-convert >/dev/null || { echo "rsvg-convert is required (brew install librsvg)" >&2; exit 1; }

for size in 16 24 32 48 64 128 256 512 1024; do
  rsvg-convert --width "$size" --height "$size" --output "$dir/BGMail-$size.png" "$dir/BGMail.svg"
done

python3 -I - "$dir" <<'PY'
import struct, sys
from pathlib import Path

d = Path(sys.argv[1])
png = lambda size: (d / f"BGMail-{size}.png").read_bytes()

# ICO: 6-byte header, 16-byte entries, then PNG frames (256 is stored as 0).
sizes = (16, 24, 32, 48, 64, 128, 256)
frames = [png(s) for s in sizes]
offset = 6 + 16 * len(sizes)
head = struct.pack("<HHH", 0, 1, len(sizes))
for size, data in zip(sizes, frames):
    edge = size % 256
    head += struct.pack("<BBBBHHII", edge, edge, 0, 0, 1, 32, len(data), offset)
    offset += len(data)
(d / "BGMail.ico").write_bytes(head + b"".join(frames))

# ICNS: retina types reuse the doubled PNG.
types = ((b"icp4", 16), (b"icp5", 32), (b"icp6", 64), (b"ic07", 128),
         (b"ic08", 256), (b"ic09", 512), (b"ic10", 1024), (b"ic11", 32),
         (b"ic12", 64), (b"ic13", 256), (b"ic14", 512))
body = b"".join(t + struct.pack(">I", 8 + len(png(s))) + png(s) for t, s in types)
(d / "BGMail.icns").write_bytes(b"icns" + struct.pack(">I", 8 + len(body)) + body)
PY
echo "Regenerated app icons in $dir"
