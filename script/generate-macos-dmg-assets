#!/usr/bin/env bash
# Rasterizes the DMG art in crates/bgmail/packaging/macos/ (background.svg,
# volume-icon.svg) into the committed PNG/ICNS files. Run on macOS after editing
# either SVG or the app icon (assets/appIcon/BGMail.svg); the release build only
# uses the committed rasters, so CI needs neither rsvg-convert nor this script.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
assets="${1:-$root/crates/bgmail/packaging/macos}"
command -v rsvg-convert >/dev/null || { echo "rsvg-convert is required (brew install librsvg)" >&2; exit 1; }
command -v iconutil >/dev/null || { echo "iconutil is required (macOS)" >&2; exit 1; }

render() { # svg out width height
  rsvg-convert --width "$3" --height "$4" --output "$2" "$1"
}

render "$assets/background.svg" "$assets/background.png" 800 400
render "$assets/background.svg" "$assets/background@2x.png" 1600 800

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# volume-icon.svg references the app icon by a sibling path: librsvg refuses
# to load images from parent directories.
cp "$assets/volume-icon.svg" "$assets/white-drive-tahoe.png" "$work/"
cp "$root/assets/appIcon/BGMail.svg" "$work/"
iconset="$work/volume-icon.iconset"
mkdir "$iconset"
for size in 16 32 128 256 512; do
  render "$work/volume-icon.svg" "$iconset/icon_${size}x${size}.png" "$size" "$size"
  double=$((size * 2))
  render "$work/volume-icon.svg" "$iconset/icon_${size}x${size}@2x.png" "$double" "$double"
done
iconutil --convert icns --output "$assets/volume-icon.icns" "$iconset"
echo "Wrote background.png, background@2x.png and volume-icon.icns in $assets"
